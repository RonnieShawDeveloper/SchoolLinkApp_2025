# ==========================================
# OpenEMIS Configuration
# ==========================================

# Base URL for the OpenEMIS Core API.
# Default (UAT): https://bs-moe-uat.openemis.org/core
# Production: [Insert Production URL]
EMIS_BASE_URL=https://bs-moe-uat.openemis.org/core

# API Key for authenticating with the OpenEMIS API.
# This key is kept server-side to prevent exposure to the client.
EMIS_API_KEY=

# Default username for OpenEMIS authentication if not provided in the request.
DEFAULT_EMIS_USER=

# Default password for OpenEMIS authentication if not provided in the request.
DEFAULT_EMIS_PASS=

# ==========================================
# LMS (Learning Management System) Configuration
# ==========================================

# Base URL for the LMS Attendance API.
# Default (Dev): https://bahamas-dev.1on1staging.com/API/v1.0/Plugin/AttendanceAPI
LMS_BASE_URL=https://bahamas-dev.1on1staging.com/API/v1.0/Plugin/AttendanceAPI

# API Key for authenticating with the LMS Attendance API.
# Used for Basic Authentication headers.
LMS_API_KEY=
